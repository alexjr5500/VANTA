# =============================================================================
# VANTA - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to version control.
#
# Required variables are marked with (REQUIRED)
# Optional variables have default values shown
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
ELECTRON_URL=app://.

# =============================================================================
# DATABASE (REQUIRED)
# =============================================================================
# Local development (SQLite):
# DATABASE_URL=file:./dev.db
# Production (PostgreSQL):
DATABASE_URL=postgresql://user:password@localhost:5432/vanta

# =============================================================================
# REDIS (for caching, sessions, queues)
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# LIVEKIT WEBRTC (REQUIRED for livestreaming)
# =============================================================================
# Server-side HTTP(S) endpoint used by the backend room service.
LIVEKIT_HOST=http://localhost:7880
LIVEKIT_API_KEY=devkey
# Local dev default (matches `livekit-server --dev`); use a strong secret in production.
LIVEKIT_API_SECRET=secret
# Browser-facing WebSocket endpoint. Production must use wss://.
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# =============================================================================
# PRIVATE CALLS — WEBRTC ICE SERVERS
# =============================================================================
# Optional JSON array of RTCIceServer objects for 1-to-1 voice/video calls.
# Public Google STUN is the built-in fallback, so this is only needed when the
# deployment must relay calls through TURN (symmetric NAT / strict networks):
#   RTC_ICE_SERVERS=[{"urls":["turn:turn.example.com:3478?transport=udp","turns:turn.example.com:5349?transport=tcp"],"username":"user","credential":"secret"}]
# Leave empty to rely on the client's built-in public STUN servers.
RTC_ICE_SERVERS=

# =============================================================================
# JWT AUTHENTICATION (REQUIRED - generate strong secrets in production)
# =============================================================================
# Generate secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_REFRESH_SECRET=change-this-to-a-different-strong-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
JWT_ACCESS_EXPIRES_IN=15m
JWT_REMEMBER_ME_EXPIRES_IN=30d
# Set true only when email verification is fully enabled for the deployment.
REQUIRE_EMAIL_VERIFICATION=false

# =============================================================================
# ENCRYPTION (REQUIRED for sensitive data at rest)
# =============================================================================
ENCRYPTION_KEY=change-this-to-a-32-character-hex-string
ENCRYPTION_SALT=vanta-encryption-salt

# =============================================================================
# SUPERTOKENS (Authentication)
# =============================================================================
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=
SUPERTOKENS_API_DOMAIN=http://localhost:5000
SUPERTOKENS_WEBSITE_DOMAIN=http://localhost:3000

# =============================================================================
# CLOUDINARY (Media Storage)
# =============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =============================================================================
# STRIPE (Payments)
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# EMAIL (SMTP)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@vanta.app

# =============================================================================
# CDN CONFIGURATION
# =============================================================================
CDN_URL=https://cdn.vanta.app
CDN_API_KEY=

# =============================================================================
# PERFORMANCE MONITORING
# =============================================================================
SLOW_QUERY_THRESHOLD=200
METRICS_INTERVAL=60000

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_API_MAX=60
RATE_LIMIT_API_WINDOW=60000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900000
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW=3600000
RATE_LIMIT_PASSWORD_RESET_MAX=3
RATE_LIMIT_PASSWORD_RESET_WINDOW=3600000
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_OTP_WINDOW=900000
RATE_LIMIT_MESSAGING_MAX=1
RATE_LIMIT_MESSAGING_WINDOW=1000
RATE_LIMIT_SEARCH_MAX=30
RATE_LIMIT_SEARCH_WINDOW=60000
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_UPLOAD_WINDOW=3600000

# =============================================================================
# FILE UPLOADS
# =============================================================================
# local (development) or cloudinary (Cloudinary is selected automatically when
# all three CLOUDINARY_* credentials above are set)
UPLOAD_STORAGE_DIR=./public/uploads
# Public API/CDN origin only; do not include /uploads (e.g. https://api.example.com)
UPLOAD_PUBLIC_BASE_URL=http://localhost:5000
MAX_FILE_SIZE=10485760
MAX_IMAGE_SIZE=5242880
MAX_VIDEO_SIZE=104857600
MAX_VIDEO_DURATION_SECONDS=600
# Required for duration validation when using local storage in production.
FFPROBE_PATH=ffprobe
VIRUS_SCAN_ENABLED=false

# =============================================================================
# SECURITY
# =============================================================================
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_HISTORY=5
PASSWORD_EXPIRY_DAYS=90
MAX_SESSIONS_PER_USER=10
SESSION_CLEANUP_INTERVAL=3600000
BOT_PROTECTION_ENABLED=true
CAPTCHA_ENABLED=false
CAPTCHA_THRESHOLD=0.5
SUSPICIOUS_SCORE_THRESHOLD=0.7
MAX_FAILED_LOGINS=5
LOCKOUT_DURATION=900000
LOCKOUT_DURATION_MS=900000
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_ESCALATION_THRESHOLD=10
LOCKOUT_ESCALATION_DURATION=3600000
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
TOTP_ISSUER=VANTA
TOTP_BACKUP_CODES=8
TRUSTED_DEVICE_EXPIRY_DAYS=30
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_MAX_AGE=86400
HSTS_MAX_AGE=31536000
GDPR_ENABLED=true
DATA_RETENTION_DAYS=730
DELETION_GRACE_PERIOD_DAYS=30

# =============================================================================
# AI / MODERATION SERVICE
# =============================================================================
AI_SERVICE_URL=http://localhost:5003
AI_AUTO_MODERATE=false

# =============================================================================
# BACKUP
# =============================================================================
BACKUP_DIR=./backups

# =============================================================================
# BACKGROUND JOBS
# =============================================================================
JOB_CONCURRENCY=10
JOB_MAX_RETRIES=3
JOB_BACKOFF_DELAY=1000

# =============================================================================
# CIRCUIT BREAKER
# =============================================================================
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=3
CIRCUIT_BREAKER_TIMEOUT_MS=30000

# =============================================================================
# IMAGE OPTIMIZATION (via Sharp)
# =============================================================================
IMAGE_QUALITY_HIGH=85
IMAGE_QUALITY_MEDIUM=70
IMAGE_QUALITY_LOW=50

# =============================================================================
# CACHE TTLs (in milliseconds)
# =============================================================================
CACHE_TTL_SHORT=30000
CACHE_TTL_MEDIUM=300000
CACHE_TTL_LONG=3600000
CACHE_TTL_VERY_LONG=86400000

# =============================================================================
# VANTA COIN PURCHASES — PAYMENT GATEWAY
# =============================================================================
# test = sandbox/test gateway (dev only, never in production). No address needed.
# live = real crypto payments to the OFFICIAL VANTA receiving wallet.
# The backend is authoritative and ALWAYS uses OFFICIAL_VANTA_RECEIVING_WALLET
# (0x7fa9677c65272d80b06cb0c3a9bbeeba8f95db56) as the receiving address; setting
# a DIFFERENT value here is ignored (and logged). This public address is not a
# secret, but NEVER commit private keys or webhook secrets.
VANTA_COIN_PAYMENT_MODE=test
VANTA_COIN_PAYMENT_ADDRESS=0x7fa9677c65272d80b06cb0c3a9bbeeba8f95db56
VANTA_COIN_PAYMENT_TEST_SECRET=change-this-to-a-strong-random-secret
VANTA_COIN_PAYMENT_WEBHOOK_SECRET=change-this-to-a-different-strong-random-secret
VANTA_TEST_PAYMENT_ADDRESS=0x0000000000000000000000000000000000000000

# =============================================================================
# LIVE ON-CHAIN VERIFICATION (BLOCKCHAIN JSON-RPC)
# =============================================================================
# Before ANY live payment is credited/badge activated, the backend independently
# queries the chain and verifies the transaction (recipient = official wallet,
# token contract, amount, confirmations). Endpoints are server-side only.
# Public defaults are used when unset.
VANTA_BSC_RPC_URL=
VANTA_BASE_RPC_URL=
VANTA_BLOCKCHAIN_MIN_CONFIRMATIONS=1
VANTA_BLOCKCHAIN_AMOUNT_TOLERANCE_USD=0.005
VANTA_BLOCKCHAIN_RPC_TIMEOUT_MS=8000

# =============================================================================
# FRONTEND (NEXT_PUBLIC_* variables exposed to browser)
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_SENTRY_DSN=

# =============================================================================
# OAUTH PROVIDERS
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth callback URIs. The callback PATH is fixed as /api/auth/oauth/callback/:provider.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/oauth/callback/google
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_KEY_SECRET=
APPLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/apple/callback

# Backend public URL used to derive provider callback URLs when the per-provider
# redirect-URI variables above are unset. PRODUCTION NEVER FALLS BACK TO
# localhost: the resolver prefers BACKEND_PUBLIC_URL / BACKEND_URL, then
# Railway-injected RAILWAY_STATIC_URL / RAILWAY_PUBLIC_DOMAIN, then the known
# production deployment URL
# (https://carefree-luck-production-8298.up.railway.app). The value is only a
# dev convenience here.
# BACKEND_PUBLIC_URL=http://localhost:5000
# BACKEND_URL=

# OAuth `state` TTL in seconds (server-side OAuthState records). Default 600
# (10 minutes), maximum 1800 (30 minutes).
# OAUTH_STATE_TTL_SECONDS=600

# =============================================================================
# SMS / PHONE OTP
# =============================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_GOOGLE_AUTH=true
ENABLE_APPLE_AUTH=true
ENABLE_PHONE_OTP=true
ENABLE_EMAIL_PASSWORD=true
ENABLE_GIFTS=true
ENABLE_LIVE_STREAMING=true
ENABLE_MESSAGING=true
