<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Match the native starting window to VANTA's app-level dark background color. -->
    <color name="vanta_launch_background">#1F2630</color>

    <style name="Theme.Vanta" parent="@android:style/Theme.Material.NoActionBar">
        <!-- Pre-Android 12 launch window and Android 12+ system splash. -->
        <item name="android:windowBackground">@color/vanta_launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/vanta_launch_background</item>
        <item name="android:colorBackground">@color/vanta_launch_background</item>
        <!-- Do not briefly show pale status/navigation bars while the WebView loads. -->
        <item name="android:statusBarColor">@color/vanta_launch_background</item>
        <item name="android:navigationBarColor">@color/vanta_launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
