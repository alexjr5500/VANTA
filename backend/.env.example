# ============================================
# VANTA Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values

# ============================================
# DATABASE
# ============================================

# Local Development (SQLite)
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL)
# DATABASE_URL="postgresql://user:password@host:5432/vanta?schema=public"

# ============================================
# SERVER
# ============================================

PORT=5000
NODE_ENV="development"  # development | production

# ============================================
# CORS & FRONTEND
# ============================================

# The frontend origin(s) allowed by CORS. For LAN/phone HTTPS development this
# must be the LAN origin, e.g. FRONTEND_URL="https://10.174.123.177:3000".
FRONTEND_URL="http://localhost:3000"

# Optional: comma-separated list of ADDITIONAL origins allowed by CORS (exact
# origins only — never "*", because VANTA auth uses cookies/Bearer tokens).
# In production this must include the exact Vercel frontend origin, e.g.:
#   CORS_ALLOWED_ORIGINS="https://vanta-nu.vercel.app"
# (FRONTEND_URL is always added to the allow list as well.)
CORS_ALLOWED_ORIGINS=""

# ============================================
# LOCAL HTTPS (dev only - optional)
# ============================================
# Serve the API + Socket.IO over TLS (https:// / wss://) so an HTTPS frontend
# page (e.g. https://<LAN-IP>:3000 on a phone) is not blocked as mixed content.
# Set both to the mkcert leaf cert/key generated under frontend/.certs-dev:
#   HTTPS_DEV_CERT="C:/absolute/path/to/frontend/.certs-dev/vanta-local.pem"
#   HTTPS_DEV_KEY="C:/absolute/path/to/frontend/.certs-dev/vanta-local-key.pem"
# When both are unset the server falls back to plain HTTP on PORT.

# ============================================
# JWT AUTHENTICATION
# ============================================

# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-this-to-a-strong-random-secret-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="change-this-to-a-different-strong-random-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# ============================================
# GOOGLE OAUTH (OIDC) — Continue with Google
# ============================================
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# (Application type: Web). Authorized redirect URI must EXACTLY match
# GOOGLE_OAUTH_REDIRECT_URI (below). The client secret is server-side only and
# is never sent to the browser.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must be registered in Google Cloud Console -> Authorized redirect URIs.
# The backend callback path is: <BACKEND_PUBLIC_URL>/api/auth/oauth/callback/google
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:5000/api/auth/oauth/callback/google"

# ============================================
# TELEGRAM OAUTH (OIDC) — Continue with Telegram
# ============================================
# Create a bot with @BotFather, then open Login Widget settings and add the
# Allowed URL(s) for your site. BotFather displays the Client ID and Client
# Secret — those are TELEGRAM_BOT_ID / TELEGRAM_BOT_SECRET here. The secret is
# server-side only. See https://core.telegram.org/widgets/login.
TELEGRAM_BOT_ID=""
TELEGRAM_BOT_SECRET=""
# Must be registered in @BotFather -> Login Widget -> Allowed URLs.
# The backend callback path is: <BACKEND_PUBLIC_URL>/api/auth/oauth/callback/telegram
TELEGRAM_OAUTH_REDIRECT_URI="http://localhost:5000/api/auth/oauth/callback/telegram"

# ============================================
# OAUTH RUNTIME CONFIG
# ============================================
# Public origin of the backend, used to build provider callback URLs when the
# per-provider GOOGLE_OAUTH_REDIRECT_URI / TELEGRAM_OAUTH_REDIRECT_URI values
# are unset. In production this is the deployed backend URL (e.g. Railway
# generated domain); in local dev it is http://localhost:5000.
BACKEND_PUBLIC_URL="http://localhost:5000"

# Optional tuning (seconds). Defaults:
#   OAUTH_STATE_TTL_SECONDS=600        state/CSRF ticket lifetime
#   OAUTH_EXCHANGE_CODE_TTL_SECONDS=300  one-time session exchange code lifetime
#   OAUTH_REGISTRATION_TICKET_TTL_SECONDS=900  OAuth signup ticket lifetime
OAUTH_STATE_TTL_SECONDS="600"
OAUTH_EXCHANGE_CODE_TTL_SECONDS="300"
OAUTH_REGISTRATION_TICKET_TTL_SECONDS="900"

# Administrator account password (used by `npm run seed` / verification scripts).
# REQUIRED in production — the seed refuses to run without it rather than creating
# a guessable admin. Never commit the real value; provide it as an environment
# variable (Railway backend Variables / backend/.env). Locally, when omitted, a
# random password is generated and printed once.
ADMIN_PASSWORD=""

# ============================================
# DEVELOPMENT-ONLY ADMIN BALANCE (never in production)
# ============================================
# Development/test-only free balance granted to the CEO/admin account
# (ceo@vanta.app) on every seed/startup so the full economy (gifts, transfers,
# purchases, monetization, deductions) can be exercised.
#
#   ADMIN_DEV_BALANCE=1000000
#
# ⚠️  DEVELOPMENT/TEST ONLY. Never use as a production free-money mechanism.
#   - The grant is HARD-DISABLED when NODE_ENV === "production", so simply
#     having this variable present CANNOT activate it in production.
#   - It is idempotent: the seed only tops the wallet UP to this value and
#     never reduces a higher balance, so it never stacks consecutive grants.
#   - Leave UNSET (or unset in production) to use the default of 1000000.
ADMIN_DEV_BALANCE=1000000

# ============================================
# OAUTH - GOOGLE
# ============================================

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:5000/api/auth/google/callback"

# ============================================
# OAUTH - APPLE
# ============================================

APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_KEY_SECRET=""
APPLE_OAUTH_REDIRECT_URI="http://localhost:5000/api/auth/apple/callback"

# ============================================
# SMS / PHONE OTP
# ============================================

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""

# ============================================
# EMAIL SERVICE
# ============================================

EMAIL_SERVICE="sendgrid"
SENDGRID_API_KEY=""
EMAIL_FROM_ADDRESS="noreply@vanta.app"

# ============================================
# PAYMENT GATEWAY
# ============================================

# Base URL of the hosted payment/checkout page used to build payment links.
# This URL is owned by the payment gateway provider you integrate with (e.g.
# Stripe Checkout / PayPal hosted page) and MUST be set to the provider's real
# production URL. Do NOT invent or hardcode a VANTA-branded payment domain.
# When set, trailing slashes are optional. Leave empty to keep the non-branded
# example.com placeholder (mock/dev only - links point at a placeholder page).
PAYMENT_LINK_BASE_URL=""

# ============================================
# RATE LIMITING
# ============================================

RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# ============================================
# OTP SETTINGS
# ============================================

OTP_LENGTH="6"
OTP_EXPIRY_MINUTES="10"
OTP_MAX_ATTEMPTS="3"

# ============================================
# VANTA COIN PURCHASES — PAYMENT GATEWAY
# ============================================
# Payment mode for the Balance "Buy Coins" flow:
#   test  -> sandbox/test payment gateway. The UI clearly labels it as a
#            simulated payment and the backend credits coins only after the
#            order's HMAC simulate token is verified. NEVER used in production
#            (a production deployment is forced to live mode).
#   live  -> real crypto payments to VANTA_COIN_PAYMENT_ADDRESS; coins are only
#            credited after server-side provider verification (HMAC webhook),
#            never from a client-submitted tx hash.
# If unset, non-production deployments run in test mode; production requires
# VANTA_COIN_PAYMENT_MODE=live (and a real address) to offer purchases.
VANTA_COIN_PAYMENT_MODE="test"

# REQUIRED for LIVE mode only — the destination address users send crypto to.
# Must be a valid EVM address (0x + 40 hex chars). Keep empty in development
# (the clearly-fake test gateway address is used instead). NEVER commit a real
# wallet address to version control.
VANTA_COIN_PAYMENT_ADDRESS=""

# Secret used to sign/verify the test-mode simulate tokens (dev only).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
VANTA_COIN_PAYMENT_TEST_SECRET=""

# REQUIRED for LIVE mode: shared secret used to authenticate payment-provider
# webhooks (HMAC-SHA256 over the raw body). If empty, live webhooks are
# rejected and no live payment can EVER credit coins. NEVER commit the real
# webhook secret.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VANTA_COIN_PAYMENT_WEBHOOK_SECRET=""

# Optional placeholder address shown on the test payment screen (must be a
# valid 0x + 40-hex address). Defaults to a clearly fake all-zero address.
VANTA_TEST_PAYMENT_ADDRESS="0x0000000000000000000000000000000000000000"

# ============================================
# MONITORING & LOGGING
# ============================================

LOG_LEVEL="debug"
SENTRY_DSN=""
