# ============================================
# VANTA Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values

# ============================================
# DATABASE
# ============================================

# Local Development (SQLite)
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL)
# DATABASE_URL="postgresql://user:password@host:5432/vanta?schema=public"

# ============================================
# SERVER
# ============================================

PORT=5000
NODE_ENV="development"  # development | production

# ============================================
# CORS & FRONTEND
# ============================================

# The frontend origin(s) allowed by CORS. For LAN/phone HTTPS development this
# must be the LAN origin, e.g. FRONTEND_URL="https://10.174.123.177:3000".
FRONTEND_URL="http://localhost:3000"

# Optional: comma-separated list of ADDITIONAL origins allowed by CORS (exact
# origins only — never "*", because VANTA auth uses cookies/Bearer tokens).
# In production this must include the exact Vercel frontend origin, e.g.:
#   CORS_ALLOWED_ORIGINS="https://vanta-nu.vercel.app"
# (FRONTEND_URL is always added to the allow list as well.)
CORS_ALLOWED_ORIGINS=""

# ============================================
# LOCAL HTTPS (dev only - optional)
# ============================================
# Serve the API + Socket.IO over TLS (https:// / wss://) so an HTTPS frontend
# page (e.g. https://<LAN-IP>:3000 on a phone) is not blocked as mixed content.
# Set both to the mkcert leaf cert/key generated under frontend/.certs-dev:
#   HTTPS_DEV_CERT="C:/absolute/path/to/frontend/.certs-dev/vanta-local.pem"
#   HTTPS_DEV_KEY="C:/absolute/path/to/frontend/.certs-dev/vanta-local-key.pem"
# When both are unset the server falls back to plain HTTP on PORT.

# ============================================
# JWT AUTHENTICATION
# ============================================

# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-this-to-a-strong-random-secret-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="change-this-to-a-different-strong-random-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# ============================================
# OAUTH - GOOGLE
# ============================================

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:5000/api/auth/google/callback"

# ============================================
# OAUTH - APPLE
# ============================================

APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_KEY_SECRET=""
APPLE_OAUTH_REDIRECT_URI="http://localhost:5000/api/auth/apple/callback"

# ============================================
# SMS / PHONE OTP
# ============================================

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""

# ============================================
# EMAIL SERVICE
# ============================================

EMAIL_SERVICE="sendgrid"
SENDGRID_API_KEY=""
EMAIL_FROM_ADDRESS="noreply@vanta.app"

# ============================================
# PAYMENT GATEWAY
# ============================================

# Base URL of the hosted payment/checkout page used to build payment links.
# This URL is owned by the payment gateway provider you integrate with (e.g.
# Stripe Checkout / PayPal hosted page) and MUST be set to the provider's real
# production URL. Do NOT invent or hardcode a VANTA-branded payment domain.
# When set, trailing slashes are optional. Leave empty to keep the non-branded
# example.com placeholder (mock/dev only - links point at a placeholder page).
PAYMENT_LINK_BASE_URL=""

# ============================================
# RATE LIMITING
# ============================================

RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# ============================================
# OTP SETTINGS
# ============================================

OTP_LENGTH="6"
OTP_EXPIRY_MINUTES="10"
OTP_MAX_ATTEMPTS="3"

# ============================================
# VANTA COIN PURCHASES — PAYMENT GATEWAY
# ============================================
# Payment mode for the Balance "Buy Coins" flow:
#   test  -> sandbox/test payment gateway. The UI clearly labels it as a
#            simulated payment and the backend credits coins only after the
#            order's HMAC simulate token is verified. NEVER used in production.
#   live  -> real crypto payments to VANTA_COIN_PAYMENT_ADDRESS; coins are only
#            credited after provider-side verification (webhook), never from a
#            client-submitted tx hash.
# Leave empty to default to live mode.
VANTA_COIN_PAYMENT_MODE="test"

# REQUIRED for live mode only - the destination address users send crypto to.
# Keep empty in development (the test gateway address is used instead).
VANTA_COIN_PAYMENT_ADDRESS=""

# Secret used to sign/verify the test-mode simulate tokens (dev only).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
VANTA_COIN_PAYMENT_TEST_SECRET=""

# Optional placeholder address shown on the test payment screen (must be a
# valid 0x + 40-hex address). Defaults to a clearly fake all-zero address.
VANTA_TEST_PAYMENT_ADDRESS="0x0000000000000000000000000000000000000000"

# ============================================
# MONITORING & LOGGING
# ============================================

LOG_LEVEL="debug"
SENTRY_DSN=""
