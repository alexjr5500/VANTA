# Isolated staging recovery worker only. Never select this image for production.
# Match the dedicated acceptance PostgreSQL server major version.
FROM node:22-trixie-slim AS node_runtime
FROM postgres:18-trixie
COPY --from=node_runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node_runtime /usr/local/lib/node_modules/ /usr/local/lib/node_modules/
RUN ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates openssl libatomic1 ffmpeg \
 && rm -rf /var/lib/apt/lists/* \
 && node --version \
 && pg_dump --version | grep -E '^pg_dump \(PostgreSQL\) 18\.' \
 && pg_restore --version | grep -E '^pg_restore \(PostgreSQL\) 18\.' \
 && psql --version | grep -E '^psql \(PostgreSQL\) 18\.'
WORKDIR /app
COPY backend/ ./backend/
RUN npm --prefix backend install --include=dev && npm --prefix backend run build
# The postgres base image is used for its compatible client binaries only.
# Do not initialize or run a local PostgreSQL server in the recovery worker.
ENTRYPOINT []
CMD ["node", "backend/scripts/acceptance-provider-probe.mjs", "worker"]
