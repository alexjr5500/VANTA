# Opt-in, one-shot maintenance image. Never deploy as the ordinary API.
# A separately approved offline window and verified volume ownership are required.
FROM node:22-trixie-slim AS node_runtime
FROM postgres:18-trixie
COPY --from=node_runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node_runtime /usr/local/lib/node_modules/ /usr/local/lib/node_modules/
RUN ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates libatomic1 age tar \
 && rm -rf /var/lib/apt/lists/* \
 && pg_dump --version | grep -E '^pg_dump \(PostgreSQL\) 18\.' \
 && pg_restore --version | grep -E '^pg_restore \(PostgreSQL\) 18\.' \
 && age --version
WORKDIR /app
COPY backend/backup-runtime/package.json backend/backup-runtime/package-lock.json ./backend/backup-runtime/
RUN npm --prefix backend/backup-runtime ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY backend/scripts/backup-*.mjs ./backend/scripts/
COPY backend/scripts/backup-age-encrypt.sh ./backend/scripts/
ENTRYPOINT []
CMD ["node", "backend/scripts/backup-offline-runner.mjs"]
