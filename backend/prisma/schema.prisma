  sentAt         DateTime  @default(now())
  deliveredAt    DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([notificationId])
  @@index([userId, sentAt])
  @@index([channel, sentAt])
  @@index([opened, clicked, converted])
}

model UserLTV {
  id                 String   @id @default(cuid())
  userId             String   @unique
  totalRevenue       Float    @default(0)
  totalSpend         Float    @default(0)
  totalPurchases     Int      @default(0)
  totalGifts         Int      @default(0)
  totalSubscriptions Int      @default(0)
  daysActive         Int      @default(0)
  predictedLTV       Float?
  tier               String   @default("BRONZE")
  lastCalculated     DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([totalRevenue])
  @@index([tier])
  @@index([predictedLTV])
}

model ScreenAnalytics {
  id              String   @id @default(cuid())
  screenName      String
  date            DateTime
  views           Int      @default(0)
  uniqueViews     Int      @default(0)
  avgTimeOnScreen Float    @default(0)
  totalTime       Float    @default(0)
  exits           Int      @default(0)
  bounceRate      Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([screenName, date])
  @@index([screenName, date])
  @@index([date])
  @@index([views, date])
}

model APIPerformance {
  id           String   @id @default(cuid())
  endpoint     String
  method       String
  statusCode   Int
  responseTime Float
  userId       String?
  ipAddress    String?
  timestamp    DateTime @default(now())

  @@index([endpoint, timestamp])
  @@index([statusCode, timestamp])
  @@index([responseTime, timestamp])
  @@index([timestamp])
}

model QueryPerformance {
  id        String   @id @default(cuid())
  query     String
  duration  Float
  model     String
  operation String
  timestamp DateTime @default(now())

  @@index([model, operation, timestamp])
  @@index([duration, timestamp])
  @@index([timestamp])
}

model AdRevenue {
  id          String   @id @default(cuid())
  date        DateTime
  provider    String
  revenue     Float
  impressions Int      @default(0)
  clicks      Int      @default(0)
  cpm         Float?
  cpc         Float?
  fillRate    Float?
  ecpm        Float?
  createdAt   DateTime @default(now())

  @@unique([date, provider])
  @@index([date])
  @@index([provider, date])
}

model ARPUAnalytics {
  id          String   @id @default(cuid())
  date        DateTime
  period      String
  arpu        Float
  payingUsers Int      @default(0)
  totalUsers  Int      @default(0)
  revenue     Float
  createdAt   DateTime @default(now())

  @@unique([date, period])
  @@index([date, period])
}

// ==========================================
// VERIFICATION & CREATOR MEMBERSHIP SYSTEM
// ==========================================

/// VerificationBadge: Tracks blue/gold badges per user
model VerificationBadge {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeType   String    // BLUE or GOLD
  status      String    @default("ACTIVE") // ACTIVE, REVOKED, SUSPENDED, EXPIRED
  grantedBy   String?
  grantedAt   DateTime  @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?
  revokedBy   String?
  revokeReason String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
  @@index([badgeType, status])
}

/// VerificationRequest: Tracks user verification requests
model VerificationRequest {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestType     String    // CREATOR, BUSINESS, INDIVIDUAL
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  documents       String?
  notes           String?
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([userId, status])
}

/// SubscriptionPlan: Configurable creator membership plans
model SubscriptionPlan {
  id              String    @id @default(cuid())
  name            String    @unique
  durationMonths  Int
  price           Float
  currency        String    @default("USD")
  description     String?
  benefits        String?   // JSON array of benefit strings
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  badgeType       String    @default("GOLD")
  memberships     CreatorMembership[]
  cryptoPayments  CryptoPayment[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

/// CreatorMembership: Tracks active creator subscriptions
model CreatorMembership {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String
  plan          SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  status        String    @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED, SUSPENDED
  startDate     DateTime  @default(now())
  endDate       DateTime
  renewalDate   DateTime?
  autoRenew     Boolean   @default(false)
  cancelledAt   DateTime?
  paymentMethod String?
  paymentTxHash String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, endDate])
  @@index([endDate])
}

/// CryptoPayment: Tracks crypto payment transactions
model CryptoPayment {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String
  plan          SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  amount        Float
  currency      String    // USDT, USDC
  network       String    // BNB_SMART_CHAIN, BASE
  walletAddress String
  txHash        String?   @unique
  status        String    @default("PENDING") // PENDING, CONFIRMED, FAILED, EXPIRED
  confirmations Int       @default(0)
  expiresAt     DateTime
  confirmedAt   DateTime?
  metadata      String?   // JSON
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([txHash])
  @@index([expiresAt])
}

/// VerificationHistory: Audit log for verification actions
model VerificationHistory {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String
  performedBy String?
  details     String?   // JSON
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}
// ============================================================================
// VANTA GIVE — FUNDRAISING
// ============================================================================

model FundraiserCategory {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  emoji       String?
  sortOrder   Int           @default(0)
  isActive    Boolean       @default(true)
  fundraisers Fundraiser[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isActive, sortOrder])
}

model Fundraiser {
  id                     String             @id @default(cuid())
  slug                   String             @unique
  ownerId                String
  owner                  User               @relation("FundraiserOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Lifecycle
  status                 String             @default("DRAFT") // DRAFT, UNDER_REVIEW, MORE_INFORMATION_REQUIRED, APPROVED, PUBLISHED, SUSPENDED, REJECTED, COMPLETED, CANCELLED

  // Step 1 — Basic information
  title                  String
  summary                String?
  categoryId             String?
  category               FundraiserCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  raisingFor             String?            // SELF / FAMILY_MEMBER / FRIEND / COMMUNITY / OTHER
  country                String?
  location               String?
  currency               String             @default("USD")
  targetAmount           Float              @default(0)
  deadline               DateTime?

  // Step 2 — Story
  story                  String?
  fundsNeededFor         String?
  fundsUsage             String?
  whoBenefits            String?

  // Cover media
  coverMediaType         String?            // IMAGE / VIDEO
  coverMediaUrl          String?
  coverMediaThumbnailUrl String?

  // Step 4 — Beneficiary & payout information
  beneficiaryName        String?
  beneficiaryRelationship String?
  beneficiarySummary     String?            // non-sensitive, public
  payoutMethod           String?            // how the organizer will receive funds (e.g. WALLET_BALANCE)
  organizerNotes         String?            // intended use / payout details (private)

  // Fundraising state
  raisedAmount           Float              @default(0) // in fundraiser currency
  supporterCount         Int                @default(0)
  viewCount              Int                @default(0)
  isFeatured             Boolean            @default(false)
  verified               Boolean            @default(false) // "VANTA Verified" — admin-controlled

  // Admin-only fields
  infoRequestMessage     String?
  rejectionReason        String?
  suspensionReason       String?
  adminNote              String?
  reviewedById           String?
  reviewedAt             DateTime?
  submittedAt            DateTime?
  approvedAt             DateTime?
  publishedAt            DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?

  media                 FundraiserMedia[]
  evidence              FundraiserEvidence[]
  updates               FundraiserUpdate[]
  donations             FundraiserDonation[]
  reports               FundraiserReport[]
  auditLogs             FundraiserAuditLog[]

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([status, deadline])
  @@index([categoryId, status])
  @@index([ownerId, status])
  @@index([verified, status])
  @@index([isFeatured, status])
  @@index([slug])
}

model FundraiserMedia {
  id             String     @id @default(cuid())
  fundraiserId   String
  fundraiser     Fundraiser @relation(fields: [fundraiserId], references: [id], onDelete: Cascade)
  type           String     // IMAGE / VIDEO
  url            String
  thumbnailUrl   String?
  caption        String?
  isCover        Boolean    @default(false)
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())

  @@index([fundraiserId, sortOrder])
  @@index([fundraiserId, isCover])
}

// Private verification/supporting evidence — NEVER served from public storage.
model FundraiserEvidence {
  id            String     @id @default(cuid())
  fundraiserId  String
  fundraiser    Fundraiser @relation(fields: [fundraiserId], references: [id], onDelete: Cascade)
  uploadedById  String
  uploader      User       @relation("FundraiserEvidenceUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  filePath      String     // path inside the PRIVATE evidence storage dir (not exposed)
  originalName  String
  mimeType      String
  size          Int
  fileType      String     // IMAGE / VIDEO / DOCUMENT
  label         String?
  createdAt     DateTime   @default(now())

  @@index([fundraiserId])
  @@index([uploadedById])
}

model FundraiserUpdate {
  id            String       @id @default(cuid())
  fundraiserId  String
  fundraiser    Fundraiser   @relation(fields: [fundraiserId], references: [id], onDelete: Cascade)
  authorId      String
  author        User         @relation("FundraiserUpdateAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title         String?
  body          String
  media         String?      // JSON array [{type:'IMAGE'|'VIDEO',url,thumbnailUrl}]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([fundraiserId, createdAt])
}

model FundraiserDonation {
  id            String     @id @default(cuid())
  fundraiserId  String
  fundraiser    Fundraiser @relation(fields: [fundraiserId], references: [id], onDelete: Cascade)
  donorId       String?
  donor         User?      @relation(fields: [donorId], references: [id], onDelete: SetNull)
  amount        Float      // in fundraiser currency (display value)
  coins         Int        // VANTA coins moved (settlement)
  currency      String     @default("USD")
  fee           Float      @default(0)   // platform fee (coins)
  netCoins      Int        @default(0)   // coins credited to the organizer wallet
  message       String?
  anonymous     Boolean    @default(false)
  transactionId String?    // WalletTransaction id (FUNDRAISER_DONATION) for the donor
  status        String     @default("COMPLETED") // COMPLETED / FAILED / REFUNDED / PENDING
  createdAt     DateTime   @default(now())

  @@index([fundraiserId, createdAt])
  @@index([donorId, createdAt])
  @@index([status, fundraiserId])
}

model FundraiserReport {
  id             String     @id @default(cuid())
  fundraiserId   String
  fundraiser     Fundraiser @relation(fields: [fundraiserId], references: [id], onDelete: Cascade)
  reporterId     String
  reporter       User       @relation("FundraiserReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reason         String
  details        String?
  status         String     @default("OPEN") // OPEN / INVESTIGATING / RESOLVED / DISMISSED
  resolutionNote String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([fundraiserId, status])
  @@index([status, createdAt])
}

model FundraiserAuditLog {
  id            String     @id @default(cuid())
  fundraiserId  String
  fundraiser    Fundraiser @relation(fields: [fundraiserId], references: [id], onDelete: Cascade)
  actorId       String?
  actor         User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action        String
  fromStatus    String?
  toStatus      String?
  metadata      String?    // JSON
  createdAt     DateTime   @default(now())

  @@index([fundraiserId, createdAt])
  @@index([actorId, createdAt])
}
