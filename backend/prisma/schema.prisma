  url       String
  fileType  String
  fileName  String?
  fileSize  Int?
  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([fileType, messageId])
}

model UserPresence {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isOnline   Boolean  @default(false)
  lastActive DateTime @default(now())

  @@index([isOnline, lastActive])
  @@index([lastActive])
}

model LiveStream {
  id                String            @id @default(cuid())
  hostId            String
  host              User              @relation("HostLiveStreams", fields: [hostId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  thumbnailUrl      String?
  streamKey         String?
  playbackUrl       String?
  liveKitRoom       String?           @unique
  liveKitToken      String?
  viewerCount       Int               @default(0)
  peakViewers       Int               @default(0)
  totalViewers      Int               @default(0)
  likes             Int               @default(0)
  gifts             Int               @default(0)
  allowGifts        Boolean           @default(true)
  allowPK           Boolean           @default(false)
  active            Boolean           @default(true)
  status            String            @default("LIVE") // LIVE, ENDED, SCHEDULED
  categoryName      String?
  category          StreamCategory?   @relation(fields: [categoryName], references: [name], onDelete: SetNull)
  language          String            @default("en")
  country           String?
  recordingEnabled  Boolean           @default(false)
  recordingUrl      String?
  duration          Int               @default(0) // in seconds
  startedAt         DateTime?
  endedAt           DateTime?
  chatPaused        Boolean           @default(false)
  slowMode          Boolean           @default(false)
  slowModeInterval  Int               @default(3) // seconds between messages
  mutedUsers        String?           // JSON array of muted user IDs
  bannedUsers       String?           // JSON array of banned user IDs
  moderators        String?           // JSON array of moderator user IDs
  coHostId          String?
  coHost            User?             @relation("CoHostStreams", fields: [coHostId], references: [id], onDelete: SetNull)
  guests            String?           // JSON array of guest user IDs
  approvedGuests    String?           // JSON array of approved guest user IDs
  screenShare       Boolean           @default(false)
  beautyMode        Boolean           @default(false)
  backgroundBlur    Boolean           @default(false)
  noiseSuppression  Boolean           @default(false)
  viewers           StreamViewer[]
  chatMessages      LiveChatMessage[]
  giftEvents        LiveGiftEvent[]
  reactions         LiveReaction[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([active, viewerCount])
  @@index([hostId, active])
  @@index([categoryName, active])
  @@index([active, createdAt])
  @@index([active, categoryName, viewerCount])
  @@index([hostId, active, createdAt])
  @@index([title])
  @@index([status])
  @@index([language])
  @@index([country])
}

model LiveReaction {
  id        String     @id @default(cuid())
  streamId  String
  stream    LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime   @default(now())

  @@index([streamId, createdAt])
  @@index([userId, streamId])
}

model StreamCategory {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  streams     LiveStream[]

  @@index([name])
}

model LiveChatMessage {
  id        String     @id @default(cuid())
  streamId  String
  stream    LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime   @default(now())

  @@index([streamId, createdAt])
  @@index([userId, streamId, createdAt])
}

model StreamViewer {
  id       String     @id @default(cuid())
  streamId String
  stream   LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime   @default(now())

  @@unique([streamId, userId])
  @@index([streamId])
  @@index([userId, streamId])
}

model StreamFollower {
  id         String   @id @default(cuid())
  streamerId String
  streamer   User     @relation("StreamerFollowers", fields: [streamerId], references: [id], onDelete: Cascade)
  followerId String
  follower   User     @relation("UserStreamFollows", fields: [followerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([streamerId, followerId])
  @@index([followerId])
  @@index([streamerId, followerId, createdAt])
}

model UserSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme             String   @default("dark")
  privacyProfile    String   @default("public")
  privacyMessages   String   @default("everyone")
  privacyFollows    String   @default("everyone")
  privacyCalls      String   @default("everyone")
  privacyStories    String   @default("everyone")
  privacyLiveStream String   @default("everyone")
  privacyTagging    String   @default("everyone")
  privacyInvites    String   @default("everyone")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model NotificationPreferences {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailAlerts Boolean  @default(true)
  pushAlerts  Boolean  @default(true)
  chatAlerts  Boolean  @default(true)
  liveAlerts  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlockedUser {
  id        String   @id @default(cuid())
  userId    String
  targetId  String
  user      User     @relation("BlockedBy", fields: [userId], references: [id], onDelete: Cascade)
  target    User     @relation("BlockedTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, targetId])
  @@index([userId])
  @@index([userId, targetId])
}

model MutedUser {
  id        String   @id @default(cuid())
  userId    String
  targetId  String
  user      User     @relation("MutedBy", fields: [userId], references: [id], onDelete: Cascade)
  target    User     @relation("MutedTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, targetId])
  @@index([userId])
  @@index([userId, targetId])
}

model SecurityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  ipAddress String?
  userAgent String?
  metadata  String? // JSON
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@index([userId, action, createdAt])
  @@index([ipAddress, createdAt])
}

model Session {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token             String    @unique
  refreshToken      String?   @unique
  deviceFingerprint String?
  isTrusted         Boolean   @default(false)
  expiresAt         DateTime
  refreshExpiresAt  DateTime?
  userAgent         String?
  ipAddress         String?
  lastActiveAt      DateTime?
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
  @@index([userId, expiresAt])
  @@index([lastActiveAt])
}

// Rate limiting storage
model RateLimit {
  id        String   @id @default(cuid())
  key       String
  points    Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([key])
  @@index([expiresAt])
  @@index([key, expiresAt])
}

// Device fingerprint storage for bot detection
model DeviceFingerprint {
  id            String   @id @default(cuid())
  fingerprintId String   @unique
  userId        String?
  ipAddress     String?
  userAgent     String?
  trustScore    Float    @default(0.5)
  isSuspicious  Boolean  @default(false)
  lastSeen      DateTime @default(now())
  firstSeen     DateTime @default(now())
  visitCount    Int      @default(1)
  createdAt     DateTime @default(now())

  @@index([fingerprintId])
  @@index([isSuspicious])
  @@index([lastSeen])
  @@index([userId, fingerprintId])
  @@index([trustScore, isSuspicious])
}

// IP reputation tracking
model IPReputation {
  id           String   @id @default(cuid())
  ipAddress    String   @unique
  riskScore    Float    @default(0.0)
  requestCount Int      @default(0)
  failedLogins Int      @default(0)
  isBlocked    Boolean  @default(false)
  lastActivity DateTime @default(now())
  firstSeen    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([riskScore])
  @@index([isBlocked])
  @@index([lastActivity])
  @@index([riskScore, isBlocked, lastActivity])
}

// Consent records for GDPR compliance
model ConsentRecord {
  id        String   @id @default(cuid())
  userId    String
  type      String
  granted   Boolean  @default(true)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([userId, type, granted])
}

// Data export requests for GDPR
model DataExportRequest {
  id        String    @id @default(cuid())
  userId    String
  status    String    @default("PENDING")
  filePath  String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([status, createdAt])
}

// Account deletion requests for GDPR
model AccountDeletionRequest {
  id           String    @id @default(cuid())
  userId       String    @unique
  reason       String?
  status       String    @default("PENDING")
  scheduledFor DateTime
  processedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, scheduledFor])
}

// Webhook event log for payment security
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String    @unique
  type        String
  rawBody     String
  signature   String?
  verified    Boolean   @default(false)
  processed   Boolean   @default(false)
  status      String    @default("RECEIVED")
  error       String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([provider, eventId])
  @@index([status])
  @@index([createdAt])
  @@index([provider, status, createdAt])
}

// ==========================================
// MONETIZATION SYSTEM
// ==========================================

model SparkCoinPackage {
  id             String          @id @default(cuid())
  name           String
  coins          Int
  price          Float
  bonusCoins     Int             @default(0)
  isPopular      Boolean         @default(false)
  isActive       Boolean         @default(true)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]

  @@index([isActive, sortOrder])
  @@index([isActive, isPopular, sortOrder])
}

model PurchaseOrder {
  id              String            @id @default(cuid())
  userId          String
  packageId       String?
  coins           Int
  amount          Float
  currency        String            @default("USD")
  provider        String            @default("stripe")
  status          String            @default("PENDING")
  providerOrderId String?           @unique
  paymentMethod   String?
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  package         SparkCoinPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([providerOrderId])
  @@index([userId, status])
  @@index([provider, status, createdAt])
}

model Gift {
  id                String            @id @default(cuid())
  slug              String            @unique
  name              String
  price             Int
  icon              String?
  image             String?
  emoji             String?
  category          String            @default("popular")
  subcategory       String?
  description       String?
  animationUrl      String?
  animationType     String            @default("float")
  thumbnailUrl      String?
  glowColor         String?
  particleColor     String?
  soundEffect       String?
  isActive          Boolean           @default(true)
  isFeatured        Boolean           @default(false)
  isTrending        Boolean           @default(false)
  isPopular         Boolean           @default(false)
  isLimited         Boolean           @default(false)
  isLegendary       Boolean           @default(false)
  expiresAt         DateTime?
  sortOrder         Int               @default(0)
  comboEnabled      Boolean           @default(true)
  comboMultiplier   Float             @default(1.0)
  animationDuration Int               @default(3)
  artworkType       String            @default("artifact")
  rarity            String            @default("common")
  tier              String            @default("low")
  impactLevel       Int               @default(1)
  effectProfile     String            @default("shimmer")
  previewAssetUrl   String?
  transactions      GiftTransaction[]
  liveGiftEvents    LiveGiftEvent[]
  eventGifts        EventGift[]
  combos            GiftCombo[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([category, isActive])
  @@index([isActive, sortOrder])
  @@index([isFeatured, isActive, sortOrder])
  @@index([isTrending, isActive, sortOrder])
  @@index([isPopular, isActive, sortOrder])
  @@index([isLimited, expiresAt])
  @@index([category, subcategory, isActive])
  @@index([isLegendary, isActive])
  @@index([price, isActive])
  @@index([rarity, tier, isActive])
}

model GiftTransaction {
  id         String   @id @default(cuid())
  requestId  String?  @unique
  senderId   String
  receiverId String
  giftId     String
  streamId   String?
  amount     Int
  quantity   Int      @default(1)
  message    String?
  status     String   @default("COMPLETED")
  isCombo    Boolean  @default(false)
  comboCount Int      @default(1)
  isAnon     Boolean  @default(false)
  isSuper    Boolean  @default(false)
  gift       Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentGiftTransactions", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedGiftTransactions", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([streamId])
  @@index([createdAt])
  @@index([receiverId, createdAt])
  @@index([senderId, receiverId, createdAt])
  @@index([streamId, receiverId, createdAt])
  @@index([giftId, createdAt])
}

model LiveGiftEvent {
  id          String     @id @default(cuid())
  streamId    String
  senderId    String
  receiverId  String
  giftId      String
  giftName    String
  giftEmoji   String?
  amount      Int
  isCombo     Boolean    @default(false)
  comboCount  Int        @default(1)
  isLegendary Boolean    @default(false)
  isAnon      Boolean    @default(false)
  senderName  String?
  stream      LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  sender      User       @relation("EventSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User       @relation("EventReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  gift        Gift       @relation(fields: [giftId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@index([streamId])
  @@index([createdAt])
  @@index([streamId, createdAt])
  @@index([senderId, streamId, createdAt])
  @@index([receiverId, streamId, createdAt])
  @@index([isLegendary, streamId, createdAt])
}

model Wallet {
  id                 String              @id @default(cuid())
  coinBalance        Int                 @default(0)
  earningsBalance    Float               @default(0.0)
  lifetimeEarnings   Float               @default(0.0)
  totalCoinsPurchased Int                @default(0)
  totalCoinsReceived  Int                @default(0)
  totalCoinsSent      Int                @default(0)
  totalGiftsSent     Int                 @default(0)
  totalGiftsReceived Int                 @default(0)
  totalWithdrawn     Float               @default(0.0)
  bonusCoins         Int                 @default(0)
  lockedCoins        Int                 @default(0)
  isFrozen           Boolean             @default(false)
  frozenAt           DateTime?
  frozenBy           String?
  freezeReason       String?
  // Withdrawal wallet for USDT (BEP-20)
  usdtWalletAddress  String?
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       WalletTransaction[] @relation("WalletTransactions")
  pin                WalletPIN?
  transferLimits     TransferLimit[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model WalletPIN {
  id        String   @id @default(cuid())
  walletId  String   @unique
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  pinHash   String
  failedAttempts Int @default(0)
  lockedUntil    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletId])
}

model TransferLimit {
  id              String   @id @default(cuid())
  walletId        String
  wallet          Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  // No arbitrary per-transfer cap. Limits are configurable by admin and
  // default to the maximum supported purchase value (10,000,000 VANTA = $100,000).
  dailyLimit      Int      @default(10000000)
  dailyUsed       Int      @default(0)
  lastResetDate   DateTime @default(now())
  singleTxLimit   Int      @default(10000000)
  otpThreshold    Int      @default(10000)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([walletId])
  @@index([walletId])
}

model WalletTransaction {
  id          String   @id @default(cuid())
  walletId    String?
  wallet      Wallet?  @relation("WalletTransactions", fields: [walletId], references: [id], onDelete: SetNull)
  userId      String
  type        String   // DEPOSIT, TRANSFER_SENT, TRANSFER_RECEIVED, GIFT_SENT, GIFT_RECEIVED, WITHDRAWAL, REFUND, FEE, ADMIN_CREDIT, ADMIN_DEBIT
  amount      Float
  fee         Float    @default(0.0)
  balance     Float    @default(0.0)
  status      String   @default("COMPLETED") // PENDING, COMPLETED, FAILED, REVERSED
  description String?
  reference   String?
  metadata    String?  // JSON - stores extra info like recipientId, giftId, streamId, etc.
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([reference])
  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  @@index([status, createdAt])
  @@index([walletId, type, createdAt])
}

model Withdrawal {
  id            String    @id @default(cuid())
  userId        String
  amount        Float
  fee           Float     @default(0.0)
  netAmount     Float
  method        String    @default("USDT_BEP20")
  currency      String    @default("USDT")
  status        String    @default("PENDING")
  walletAddress String?
  cryptoNetwork String?   @default("BNB_SMART_CHAIN")
