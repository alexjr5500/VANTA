  receiver      User     @relation("ReceivedTransfers", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
  @@index([senderId, receiverId, createdAt])
  @@index([status, createdAt])
  @@index([ipAddress, createdAt])
}

model WalletAuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // PIN_SETUP, PIN_VERIFY, PIN_FAILED, TRANSFER, DEPOSIT, WITHDRAWAL, FROZEN, UNFROZEN, LIMIT_CHANGE, OTP_SENT, OTP_VERIFIED
  details   String?  // JSON
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

